  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(SDFF_X1) { 
    area : 0.126000 ; 
    cell_leakage_power : 11400.2 ; 
    pin_opposite("QN", "Q");
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    leakage_power() { 
      when : "!CK & !D & !SE & !SI & !Q & QN" ; 
      value : "13888" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & !SI & Q & !QN" ; 
      value : "15491.4" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & SI & !Q & QN" ; 
      value : "15234.5" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & SI & Q & !QN" ; 
      value : "16896.7" ; 
    }

    leakage_power() { 
      when : "!CK & !D & SE & !SI & !Q & QN" ; 
      value : "11400.2" ; 
    }

    leakage_power() { 
      when : "!CK & !D & SE & !SI & Q & !QN" ; 
      value : "14632.8" ; 
