  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(SDFF_X1) { 
    area : 0.100800 ; 
    cell_leakage_power : 9120.19 ; 
    pin_opposite("QN", "Q");
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    leakage_power() { 
      when : "!CK & !D & !SE & !SI & !Q & QN" ; 
      value : "11110.4" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & !SI & Q & !QN" ; 
      value : "12393.1" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & SI & !Q & QN" ; 
      value : "12187.6" ; 
    }

    leakage_power() { 
      when : "!CK & !D & !SE & SI & Q & !QN" ; 
      value : "13517.4" ; 
    }

    leakage_power() { 
      when : "!CK & !D & SE & !SI & !Q & QN" ; 
      value : "9120.19" ; 
    }

    leakage_power() { 
